<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SmithboxDir>$(MSBuildThisFileDirectory)..\..\tools\Smithbox_2_2_6_2026_09_20_b\</SmithboxDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Smithbox's SoulsFormats; other Smithbox DLLs are resolved at runtime from the same folder. -->
    <Reference Include="Andre.SoulsFormats">
      <HintPath>$(SmithboxDir)Andre.SoulsFormats.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
